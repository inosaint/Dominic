{
  "name": "pair-designer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:next": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev": "npm run clean:next && concurrently \"next dev -p 3000\" \"npm run build:plugin -- --watch\"",
    "build": "next build && npm run build:plugin",
    "build:plugin": "esbuild plugin/code.ts --bundle --outfile=plugin/code.js --target=es2017 --format=iife",
    "typecheck:plugin": "tsc -p plugin/tsconfig.json --noEmit",
    "start": "next start",
    "lint": "next lint"
  },
  "engines": {
    "node": "20.x || 22.x"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.20.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
